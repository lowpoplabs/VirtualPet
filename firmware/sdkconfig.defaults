# Common to both boards. Board choice is in sdkconfig.defaults.watch / .square.
CONFIG_IDF_TARGET="esp32s3"

# Flash: both builds are sized for the 16MB board.
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# 8MB octal PSRAM
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y


# Internal RAM is scarce once both radios are up, and every screen update
# needs a block of it (the SPI driver copies each strip out of PSRAM).
# So: radio stacks allocate from PSRAM where they can, the Wi-Fi receive
# pools are small (the pet never connects), a slice of internal RAM is
# held back for drivers, and screen strips are kept short.
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=98304
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
# CONFIG_ESP_WIFI_AMPDU_RX_ENABLED is not set
# CONFIG_ESP_WIFI_AMPDU_TX_ENABLED is not set
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=4
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=8
CONFIG_BSP_DISPLAY_LVGL_BUF_HEIGHT=40

CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
# Power management: lets main.c scale the CPU clock down when idle.
CONFIG_PM_ENABLE=y
# On battery the chip sleeps whenever every task is waiting (main.c turns
# this on and off with the power source). The callbacks count the sleep.
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y
CONFIG_PM_LIGHT_SLEEP_CALLBACKS=y
# By default every pin is disconnected for the length of each sleep, which
# lets go of the screen, the card and the speaker amplifier. Pins must keep
# their levels while the chip naps.
# CONFIG_ESP_SLEEP_GPIO_RESET_WORKAROUND is not set
# CONFIG_PM_SLP_DISABLE_GPIO is not set
# Keeping the CPU powered through a nap costs about a tenth of a milliamp
# and saves 8 KB of internal RAM, which is the scarcer of the two here.
# CONFIG_PM_POWER_DOWN_CPU_IN_LIGHT_SLEEP is not set
# An idle Bluetooth controller would otherwise hold the chip awake between
# scans. The pet only scans, so the rough internal clock is good enough.
CONFIG_BT_CTRL_MODEM_SLEEP=y
CONFIG_BT_CTRL_LPCLK_SEL_RTC_SLOW=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# Bluetooth LE through NimBLE, as a scanner only. With the central,
# peripheral and broadcaster roles compiled out the firmware cannot
# connect, pair or advertise even by mistake.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
# CONFIG_BT_NIMBLE_ROLE_CENTRAL is not set
# CONFIG_BT_NIMBLE_ROLE_PERIPHERAL is not set
# CONFIG_BT_NIMBLE_ROLE_BROADCASTER is not set
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=y

# Long file names on the card
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255
CONFIG_FATFS_API_ENCODING_UTF_8=y

# LVGL: keep fonts and color depth matching sim/lv_conf.h
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_OS_FREERTOS=y
CONFIG_LV_DEF_REFR_PERIOD=15
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_FONT_DEFAULT_MONTSERRAT_20=y

# USB drive mode for the memory card (card_share.c). The USB port is only
# switched to it while the owner asks; otherwise it stays the serial port.
CONFIG_TINYUSB_MSC_ENABLED=y
CONFIG_TINYUSB_MSC_BUFSIZE=4096
